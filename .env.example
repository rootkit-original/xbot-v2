# XBot v2 - Configuração de Exemplo
# Copie este arquivo para .env e configure com suas credenciais

# ================================
# BINANCE API CONFIGURATION
# ================================
# IMPORTANTE: Obtenha suas chaves em https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Use testnet para testes (recomendado inicialmente)
BINANCE_TESTNET=true

# Base URL da API (não alterar a menos que necessário)
BINANCE_API_URL=https://api.binance.com
BINANCE_TESTNET_URL=https://testnet.binance.vision

# ================================
# TELEGRAM CONFIGURATION (OPCIONAL)
# ================================
# Para receber notificações via Telegram
# 1. Crie um bot com @BotFather no Telegram
# 2. Obtenha o token do bot
# 3. Obtenha seu chat ID enviando uma mensagem para o bot e acessando:
#    https://api.telegram.org/bot<TOKEN>/getUpdates

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Configurações de notificação
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_RATE_LIMIT=1  # mensagens por segundo
TELEGRAM_NOTIFY_TRADES=true
TELEGRAM_NOTIFY_SIGNALS=true
TELEGRAM_NOTIFY_ERRORS=true
TELEGRAM_NOTIFY_PERFORMANCE=false

# ================================
# BOT CONFIGURATION
# ================================
# Diretório para armazenar dados dos bots
BOT_DATA_DIR=./data

# Número máximo de bots executando simultaneamente
MAX_CONCURRENT_BOTS=5

# Nível de risco padrão (CONSERVATIVE, MODERATE, AGGRESSIVE, HIGH, CRITICAL)
DEFAULT_RISK_LEVEL=MODERATE

# Capital inicial padrão para novos bots (em USDT)
DEFAULT_INITIAL_CAPITAL=1000

# Símbolos padrão para trading
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,ADAUSDT,DOTUSDT,LINKUSDT

# ================================
# TRADING CONFIGURATION
# ================================
# Configurações gerais de trading

# Tamanho máximo de posição (% do capital)
MAX_POSITION_SIZE=10.0

# Stop loss padrão (%)
DEFAULT_STOP_LOSS=2.0

# Take profit padrão (%)
DEFAULT_TAKE_PROFIT=4.0

# Perda máxima diária (%)
MAX_DAILY_LOSS=5.0

# Número máximo de posições simultâneas
MAX_CONCURRENT_POSITIONS=3

# Valor mínimo para uma ordem (USDT)
MIN_ORDER_VALUE=10.0

# ================================
# TECHNICAL ANALYSIS SETTINGS
# ================================
# Configurações de análise técnica

# Períodos para indicadores
RSI_PERIOD=14
EMA_SHORT_PERIOD=9
EMA_LONG_PERIOD=21
BOLLINGER_BANDS_PERIOD=20
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Limites de RSI
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# ================================
# RISK MANAGEMENT
# ================================
# Configurações de gestão de risco

# Maximum drawdown permitido (%)
MAX_DRAWDOWN=20.0

# Período para análise de VaR (dias)
VAR_PERIOD=30

# Nível de confiança para VaR (%)
VAR_CONFIDENCE_LEVEL=95

# ================================
# LOGGING CONFIGURATION
# ================================
# Configurações de logging

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Arquivo de log
LOG_FILE=./logs/xbot.log

# Rotação de logs
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Log para console
LOG_TO_CONSOLE=true

# ================================
# PERFORMANCE SETTINGS
# ================================
# Configurações de performance

# Intervalo de análise de mercado (segundos)
MARKET_ANALYSIS_INTERVAL=60

# Intervalo de verificação de sinais (segundos)
SIGNAL_CHECK_INTERVAL=30

# Intervalo de atualização de posições (segundos)
POSITION_UPDATE_INTERVAL=15

# Timeout para requisições API (segundos)
API_REQUEST_TIMEOUT=30

# ================================
# BACKUP E PERSISTENCE
# ================================
# Configurações de backup

# Habilitar backup automático
AUTO_BACKUP_ENABLED=true

# Intervalo de backup (horas)
BACKUP_INTERVAL=24

# Diretório de backup
BACKUP_DIR=./backups

# Manter backups por quantos dias
BACKUP_RETENTION_DAYS=30

# ================================
# ALERTAS E MONITORAMENTO
# ================================
# Configurações de alertas

# Alerta de alta volatilidade (%)
HIGH_VOLATILITY_THRESHOLD=10.0

# Alerta de volume anômalo (múltiplo da média)
VOLUME_ANOMALY_THRESHOLD=3.0

# Alerta de movimento de preço rápido (% em minutos)
RAPID_PRICE_MOVEMENT=5.0
RAPID_PRICE_MOVEMENT_PERIOD=5

# ================================
# DESENVOLVIMENTO E DEBUG
# ================================
# Configurações para desenvolvimento

# Modo debug
DEBUG_MODE=false

# Modo dry-run (simulação)
DRY_RUN_MODE=false

# Salvar dados de mercado para análise
SAVE_MARKET_DATA=false

# Diretório para dados de mercado
MARKET_DATA_DIR=./market_data

# ================================
# COMPLIANCE E AUDITORIA
# ================================
# Configurações de compliance

# Habilitar logs de auditoria
AUDIT_LOGGING=true

# Diretório de logs de auditoria
AUDIT_LOG_DIR=./audit_logs

# Validação rigorosa de trades
STRICT_TRADE_VALIDATION=true

# Verificação de compliance automática
AUTO_COMPLIANCE_CHECK=true

# ================================
# EXEMPLO DE CONFIGURAÇÃO AVANÇADA
# ================================
# Configurações específicas por estratégia (formato JSON)

# SCALPING_STRATEGY='{"min_profit": 0.5, "max_hold_time": 300, "volume_filter": true}'
# SWING_STRATEGY='{"min_profit": 2.0, "max_hold_time": 86400, "trend_following": true}'
# GRID_STRATEGY='{"grid_levels": 10, "grid_spacing": 1.0, "rebalance_frequency": 3600}'